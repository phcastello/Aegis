{
  "ConnectionStrings": {
    "AegisDatabase": "Host=localhost;Port=5432;Database=aegis;Username=aegis;Password=aegis_dev_password"
  },
  "Aegis": {
    "ModelProvider": "openai",
    "DefaultModel": "gpt-5.4-nano",
    "MainModel": "gpt-5.4-mini",
    "EscalationModel": "gpt-5.4",
    "UseEscalationAutomatically": false,
    "StoreResponses": false,
    "ServiceTier": "auto",
    "MaxOutputTokens": 4000,
    "WebSearchEnabled": false,
    "WebSearchRequireExplicitRequest": true,
    "MaxEmailsPerManualBriefing": 30,
    "MaxEmailsToReadPerBriefing": 15,
    "MaxEmailBriefingBodyChars": 500,
    "MaxEmailFullBodyChars": 50000,
    "EmailBriefingLookbackDays": 7
  },
  "Google": {
    "RedirectUri": "http://localhost:8080/api/email/oauth/callback",
    "OAuthScopes": "https://www.googleapis.com/auth/gmail.modify"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
