{
  "identifier": "node-identity",
  "description": "Typed Node management only; no generic HTTP or secure-storage access from the WebView.",
  "windows": [
    "main"
  ],
  "platforms": [
    "android",
    "windows"
  ],
  "permissions": [
    "allow-node-status",
    "allow-node-transport-status",
    "allow-node-transport-reconnect",
    "allow-node-pair",
    "allow-node-list",
    "allow-node-rename",
    "allow-node-set-enabled",
    "allow-node-set-target-priority",
    "allow-node-resolve-target",
    "allow-node-revoke",
    "allow-node-create-pairing-code",
    "allow-node-test-notification",
    "allow-node-notification-settings",
    "allow-node-request-notification-permission",
    "allow-node-set-autostart",
    "allow-node-exit",
    "allow-node-set-reminders",
    "allow-node-remove",
    "allow-node-reminders",
    "allow-node-places",
    "allow-node-location",
    "allow-node-geofences",
    "allow-node-settings-open",
    "allow-node-hide-keyboard",
    "allow-node-read-visibility",
    "allow-node-consume-reminder-open",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
