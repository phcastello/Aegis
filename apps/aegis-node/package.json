{
  "name": "aegis-node",
  "private": true,
  "version": "0.7.0-stage.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "npm run version:check && vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "npm run check && vite build",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:desktop": "tauri dev --target x86_64-pc-windows-msvc",
    "build:desktop": "tauri build --target x86_64-pc-windows-msvc",
    "android:init": "tauri android init",
    "dev:android": "tauri android dev",
    "build:android": "tauri android build --debug --apk --target aarch64",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked --no-default-features --lib",
    "version:sync": "node scripts/version.mjs --write",
    "version:check": "node scripts/version.mjs",
    "test:release": "node --test scripts/*.test.mjs",
    "build:android:release": "tauri android build --apk --target aarch64"
  },
  "dependencies": {
    "vue": "^3.5.22",
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.5",
    "@tauri-apps/cli": "^2.12.1"
  }
}
