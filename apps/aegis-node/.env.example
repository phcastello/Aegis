# Optional override, compiled into Rust and provided to the shared Vue client.
# Official builds use this HTTPS origin by default, even without a local file.
AEGIS_NODE_API_BASE_URL=https://aegis.phcastello.com
# Windows debug example: http://localhost:8090
# Android debug: use a reachable trusted HTTPS backend/LAN hostname, not localhost.
# Browser fetch from a bundled HTTPS WebView may block cleartext LAN HTTP (mixed content).
