AEGIS_API_PORT=8080
AEGIS_FRONTEND_PORT=5173
# Docker/PWA mode: leave empty so the PWA calls /api/... on the same origin.
# Nginx proxies /api/... to aegis-api:8080 inside Docker.
VITE_AEGIS_API_BASE_URL=

POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_password
POSTGRES_PORT=5432
AEGIS_DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=aegis;Username=aegis;Password=aegis_dev_password

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TEMPERATURE=0.6
OLLAMA_NUM_CTX=4096

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
