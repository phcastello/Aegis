AEGIS_API_PORT=8080
AEGIS_FRONTEND_PORT=5173
# Docker/PWA mode: leave empty so the PWA calls /api/... on the same origin.
# Nginx proxies /api/... to aegis-api:8080 inside Docker.
VITE_AEGIS_API_BASE_URL=

POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_password
POSTGRES_PORT=5432
AEGIS_DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=aegis;Username=aegis;Password=aegis_dev_password

OPENAI_API_KEY=

AEGIS_MODEL_PROVIDER=openai
AEGIS_DEFAULT_MODEL=gpt-5.4-nano
AEGIS_MAIN_MODEL=gpt-5.4-mini
AEGIS_ESCALATION_MODEL=gpt-5.4
AEGIS_USE_ESCALATION_AUTOMATICALLY=false

AEGIS_TITLE_PROVIDER=local
AEGIS_TITLE_LOCAL_BASE_URL=http://10.1.1.47:11434
AEGIS_TITLE_LOCAL_MODEL=qwen2.5:3b
AEGIS_TITLE_TIMEOUT_SECONDS=30
AEGIS_TITLE_MAX_OUTPUT_TOKENS=32

AEGIS_OPENAI_STORE_RESPONSES=false
AEGIS_OPENAI_SERVICE_TIER=auto
AEGIS_MAX_OUTPUT_TOKENS=4000

AEGIS_WEB_SEARCH_ENABLED=false
AEGIS_WEB_SEARCH_REQUIRE_EXPLICIT_REQUEST=true

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
