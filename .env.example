AEGIS_API_PORT=8090
AEGIS_FRONTEND_PORT=5173
# Docker/PWA mode: leave empty so the PWA calls /api/... on the same origin.
# Nginx proxies /api/... to aegis-api:8090 inside Docker.
VITE_AEGIS_API_BASE_URL=

POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_password
POSTGRES_PORT=5432
AEGIS_DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=aegis;Username=aegis;Password=aegis_dev_password

OPENAI_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8090/api/email/oauth/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.modify
GOOGLE_OAUTH_SUCCESS_REDIRECT_PATH=/?email=connected
GOOGLE_OAUTH_FAILURE_REDIRECT_PATH=/?email=connect_failed

AEGIS_MODEL_PROVIDER=openai
AEGIS_DEFAULT_MODEL=gpt-5.4-nano
AEGIS_MAIN_MODEL=gpt-5.4-mini
AEGIS_ESCALATION_MODEL=gpt-5.4
AEGIS_USE_ESCALATION_AUTOMATICALLY=false

AEGIS_TITLE_PROVIDER=local
AEGIS_TITLE_LOCAL_BASE_URL=http://10.1.1.47:11434
AEGIS_TITLE_LOCAL_MODEL=qwen2.5:3b
AEGIS_TITLE_TIMEOUT_SECONDS=30
AEGIS_TITLE_MAX_OUTPUT_TOKENS=32

AEGIS_OPENAI_STORE_RESPONSES=false
AEGIS_OPENAI_SERVICE_TIER=auto
AEGIS_MAX_OUTPUT_TOKENS=7000

# Voice remains an internal backend dependency: the PWA never receives this URL or token.
AEGIS_TTS_ENABLED=true
AEGIS_TTS_BASE_URL=http://10.1.1.47:8001
AEGIS_TTS_PROFILE=AegisVoicev1.0
AEGIS_TTS_DEFAULT_PRIORITY=50
AEGIS_TTS_CONNECT_TIMEOUT_SECONDS=5
AEGIS_TTS_FIRST_AUDIO_TIMEOUT_SECONDS=90
AEGIS_TTS_IDLE_STREAM_TIMEOUT_SECONDS=30
AEGIS_TTS_API_TOKEN=

# STT keys are intentionally separate from OPENAI_API_KEY used by the chat models.
AEGIS_STT_ENABLED=true
AEGIS_STT_PRIMARY_PROVIDER=elevenlabs
AEGIS_STT_ELEVENLABS_MODEL=scribe_v2
AEGIS_STT_ELEVENLABS_API_KEY=
AEGIS_STT_FALLBACK_ENABLED=true
AEGIS_STT_FALLBACK_PROVIDER=openai
AEGIS_STT_OPENAI_MODEL=gpt-4o-transcribe
AEGIS_STT_OPENAI_API_KEY=
AEGIS_STT_LANGUAGE=por
AEGIS_STT_TIMEOUT_SECONDS=30
AEGIS_STT_MAX_AUDIO_BYTES=20971520
AEGIS_STT_MAX_RECORDING_SECONDS=90
AEGIS_STT_MAX_KEYTERMS=80
AEGIS_STT_KEYTERMS=Aegis;oito;às oito;Qdrant;TTS;STT;GPU;CPU

AEGIS_MAX_EMAILS_PER_MANUAL_BRIEFING=100
AEGIS_MAX_EMAILS_TO_READ_PER_BRIEFING=100
AEGIS_MAX_EMAIL_BRIEFING_BODY_CHARS=500
AEGIS_MAX_EMAIL_FULL_BODY_CHARS=50000
AEGIS_EMAIL_BRIEFING_LOOKBACK_DAYS=7

AEGIS_WEB_SEARCH_ENABLED=false
AEGIS_WEB_SEARCH_REQUIRE_EXPLICIT_REQUEST=true

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
